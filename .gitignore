# 忽略所有文件
*

# 只保留 eassy 版本 PDF 和 .gitignore
!eassy_*.pdf
eassy_*_cn.pdf
!.gitignore
!revision_log.md
!eassy_*.tex

# 保留 figures 文件夹
!figures/
!figures/**

# 保留大规模文件夹
!大规模/
!大规模/**

# 保留 CPL 版本文件夹
!CPL/
!CPL/**

eassy_v2.pdf

# 保留 tensor 文件夹
!tensor/
!tensor/**

eassy_v2.pdf

# 保留 thesis 文件夹（南大本科毕业论文 + LaTeX 源码）
!thesis/
!thesis/**

# 排除 LaTeX 构建产物
thesis/source/*.aux
thesis/source/*.log
thesis/source/*.out
thesis/source/*.toc
thesis/source/*.bbl
thesis/source/*.bcf
thesis/source/*.blg
thesis/source/*.thm
thesis/source/*.xdv
thesis/source/*.fls
thesis/source/*.fdb_latexmk
thesis/source/thesis.run.xml
thesis/source/chapters/*.aux
